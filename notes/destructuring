// 1. Variable Declaration

// LVAL never can have side effects, RVAL can be reduced early and assignment logic can be applied directly...

// type LVal = Identifier 
// | MemberExpression 
// | RestElement 
// | AssignmentPattern 
// | ArrayPattern 
// | ObjectPattern 


{ // Identifier
  // 1/RVal reduction
  // 2/Assn Logic
  let a = (console.log("RVAL"), 1);
}

{ // MemberExpression
  // Not allowed
  // let a.x = (console.log("RVAL"), 1);
}

{ // RestElement
  // Not allowed
  // let ...r = (console.log("RVAL"), 1);
}

{ // AssignmentPattern
  // Not allowed, RVAL gets interpreted as AssignmentExpression instead
  // let a = v = (console.log("RVAL"), 1);
}

{ // Array Pattern
  { // Plain identifiers
    // 1/RVal reduction
    // 2/Assn Logic
    let [a,b] = [1,2]
  }
  { // Patterns
    // 1/RVal reduction
    // 2/Assn logic
    let [a, {}, [ ...x ], ...{}] = [1,2]
  }
}

{
  ([...x["f"]] = someVal);

  // Cannot update existing bindings inside declaration LVAL scope
  // let [a, [b, ...x[f]]] = someVal;
}

{
  ({a: [...x.f], b} = someVal);

  // Cannot update existing bindings inside declaration LVAL scope
  // let {a: [...x.f], b} = someVal;
}


