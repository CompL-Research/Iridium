{
  "compilerOptions": {
    "resolveJsonModule": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "#debugConfig": ["./configs/debug.ts"],
      "#utils": ["./classes/utils.ts"],
      "#graphlib": ["./externalDeps/graphlib-with-dominator-algo/index.js"]
    }
  },
  "include": ["iridium.ts", "configs/*.ts", "classes/**/*.ts"],
  "exclude": ["playground"]
}