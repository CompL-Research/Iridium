{
  "compilerOptions": {
    "module": "NodeNext",
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "target": "es2015",
    "baseUrl": ".",
    "moduleResolution": "NodeNext",
    "paths": {
      "#debugConfig": ["./configs/debug.ts"],
      "#utils": ["./classes/utils/utils.ts"],
      "#graphlib": ["./externalDeps/graphlib-with-dominator-algo/index.js"]
    }
  },
  "exclude": ["node_modules", "externalDeps", "outputs", "temp", "tests"]
}
