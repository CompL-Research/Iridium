{
  "compilerOptions": {
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "#debugConfig": ["./configs/debug.ts"],
      "#utils": ["./classes/utils.ts"],
      "#forge": ["./externalDeps/Iridium-Forge/forge.ts"]
    }
  },
  "include": ["iridium.ts", "configs/*.ts", "classes/**/*.ts"],
  "exclude": ["playground"]
}
